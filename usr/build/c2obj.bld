#!/bin/bash
echo -n C2OBJ.BAT $1 $2 # $1=basename, $2=path, $3="dep1 dep2 dep3..."
#set -x

arg={"$@"} # array: ($1 $2 ... )

SOURCE=$2/$1.c
DEPEND=${arg[@]:2} # array: ($3 $4 ... )
TARGET=$BUILD_OBJ/$1.obj

. ${BUILD_BAT}/def_quit
. ${BUILD_BAT}/opt_c
. ${BUILD_BAT}/cache_search
. ${BUILD_BAT}/compile_c
. ${BUILD_BAT}/cache_store
