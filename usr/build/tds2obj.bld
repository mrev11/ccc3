#!/bin/bash
echo -n TDS2OBJ.BAT $1 $2
#set -x

arg=("$@")  # array: ($1 $2 ... )

SOURCE=$2/$1.tds
DEPEND=${arg[@]:2} # array: ($3 $4 ... )
TARGET=$BUILD_OBJ/$1.obj

. ${BUILD_BAT}/def_quit
. ${BUILD_BAT}/opt_prg
. ${BUILD_BAT}/cache_search
. ${BUILD_BAT}/compile_tds
. ${BUILD_BAT}/compile_prg
. ${BUILD_BAT}/opt_ppo
. ${BUILD_BAT}/compile_ppo
. ${BUILD_BAT}/opt_cpp
. ${BUILD_BAT}/compile_cpp
. ${BUILD_BAT}/cache_store
